// =============================================================================
// DealFlow360 Prisma Database Schema
// An Intelligent, Self-Governing Sales Operations Platform
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
  CUSTOMER
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

enum ProductType {
  HARDWARE
  SERVICES
  SUBSCRIPTIONS
  SERVICE
  SUBSCRIPTION
}

enum SubscriptionInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT_TO_CUSTOMER
  SENT
  UNDER_NEGOTIATION
  REJECTED
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum ApprovalRoleRequired {
  SALES_MANAGER
  FINANCE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED_FOR_REVISION
}

enum LineType {
  ONE_TIME
  RECURRING
}

enum FulfillmentStatus {
  PENDING
  ALLOCATED
  PARTIALLY_FULFILLED
  FULFILLED
  BACKORDERED
  CANCELLED
}

enum BackorderStatus {
  OPEN
  WAITING_FOR_STOCK
  READY_TO_CONSOLIDATE
  CONSOLIDATED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum InventoryAdjustmentType {
  INCREASE
  DECREASE
  SET
}

enum InvoiceType {
  ONE_TIME
  RECURRING_CYCLE
  CREDIT_NOTE
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum DealHealthAlertType {
  STALLED_DEAL
  DISCOUNT_ANOMALY
  DELIVERY_SLIPPAGE
}

enum DealHealthSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// -----------------------------------------------------------------------------
// USER & IDENTITY MANAGEMENT
// -----------------------------------------------------------------------------

model User {
  id                     String   @id @default(uuid()) @db.Uuid
  email                  String   @unique
  passwordHash           String
  name                   String
  phone                  String?
  address                String?
  city                   String?
  state                  String?
  country                String?  @default("India")
  postalCode             String?
  role                   UserRole @default(SALES_REP)
  isActive               Boolean  @default(true)
  isVerified             Boolean  @default(false)
  emailVerificationToken String?
  refreshTokenHash       String?
  customerId             String?  @db.Uuid @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relationships
  customer              Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quotationsCreated     Quotation[]           @relation("SalesRepQuotations")
  approvalsHandled      ApprovalRequest[]     @relation("ReviewerApprovals")
  auditLogs             QuotationAuditLog[]
  commentsWritten       QuotationComment[]
  inventoryAdjustments  InventoryAdjustment[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// CUSTOMERS & TIERS
// -----------------------------------------------------------------------------

model Customer {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String
  companyName          String
  contactEmail         String
  phone                String?
  address              String?
  city                 String?
  state                String?
  country              String?      @default("India")
  currency             String?      @default("INR")
  isActive             Boolean      @default(true)
  tier                 CustomerTier @default(BRONZE)
  invitationTokenHash  String?
  invitationExpiresAt  DateTime?
  isInvited            Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relationships
  user       User?
  quotations Quotation[]
  invoices   Invoice[]

  @@map("customers")
}

// -----------------------------------------------------------------------------
// PRODUCTS, CATEGORIES & PRICE LISTS
// -----------------------------------------------------------------------------

model ProductCategory {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String   @unique
  description           String?
  defaultDiscountCeiling Decimal  @default(10.00) @db.Decimal(5, 2)
  createdAt             DateTime @default(now())

  // Relationships
  products      Product[]
  discountRules DiscountRule[]

  @@map("product_categories")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  categoryId  String?     @db.Uuid
  name        String
  sku         String      @unique
  description String?
  basePrice   Decimal     @db.Decimal(12, 2)
  costPrice   Decimal?    @db.Decimal(12, 2)
  taxRate     Decimal     @default(0.00) @db.Decimal(5, 2)
  currency    String      @default("INR")
  isActive    Boolean     @default(true)
  productType ProductType @default(HARDWARE)
  unit        String      @default("unit")
  isPromoted  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relationships
  category               ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants               ProductVariant[]
  priceListItems         PriceListItem[]
  quotationLines         QuotationLine[]
  inventoryItems         InventoryItem[]
  allocations            FulfillmentAllocation[]
  backorders             Backorder[]
  subscriptionSchedules SubscriptionSchedule[]
  invoiceLines          InvoiceLine[]
  pairingsPrimary       ProductPairing[]        @relation("PrimaryProduct")
  pairingsSuggested      ProductPairing[]        @relation("SuggestedProduct")

  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @db.Uuid
  attributeName  String   // e.g. "Size", "Pack"
  attributeValue String   // e.g. "16GB", "Pro Pack"
  priceDelta     Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  // Relationships
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationLines QuotationLine[]

  @@map("product_variants")
}

model PriceList {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  customerTier CustomerTier
  currency     String       @default("INR")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  items PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id          String   @id @default(uuid()) @db.Uuid
  priceListId String   @db.Uuid
  productId   String   @db.Uuid
  price       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@index([priceListId])
  @@index([productId])
  @@map("price_list_items")
}

// -----------------------------------------------------------------------------
// DISCOUNT GOVERNANCE RULES
// -----------------------------------------------------------------------------

model DiscountRule {
  id                      String               @id @default(uuid()) @db.Uuid
  name                    String?
  customerTier            CustomerTier
  productCategory         ProductType          @default(HARDWARE)
  categoryId              String?              @db.Uuid
  maxAllowedDiscount      Decimal              @db.Decimal(5, 2) // e.g. 15.00 for 15%
  approvalThresholdPercent Decimal             @default(5.00) @db.Decimal(5, 2)
  approvalRoleRequired    ApprovalRoleRequired @default(SALES_MANAGER)
  requiresManagerAbove    Decimal?             @db.Decimal(5, 2)
  requiresFinanceAbove    Decimal?             @db.Decimal(5, 2)
  isActive                Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @default(now()) @updatedAt

  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([customerTier, productCategory])
  @@map("discount_rules")
}

// -----------------------------------------------------------------------------
// QUOTATIONS & LINE ITEMS
// -----------------------------------------------------------------------------

model Quotation {
  id               String          @id @default(uuid()) @db.Uuid
  quoteNumber      String          @unique
  customerId       String          @db.Uuid
  salesRepId       String          @db.Uuid
  status           QuotationStatus @default(DRAFT)
  currency         String          @default("INR")
  subtotalAmount   Decimal         @default(0.00) @db.Decimal(14, 2)
  discountTotal    Decimal         @default(0.00) @db.Decimal(14, 2)
  taxTotal         Decimal         @default(0.00) @db.Decimal(14, 2)
  totalAmount      Decimal         @default(0.00) @db.Decimal(14, 2)
  marginPercentage Decimal         @default(0.00) @db.Decimal(5, 2)
  blendedRiskScore Decimal         @default(0.00) @db.Decimal(5, 2)
  notes            String?
  portalToken      String          @unique @default(uuid())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relationships
  customer              Customer                @relation(fields: [customerId], references: [id])
  salesRep              User                    @relation("SalesRepQuotations", fields: [salesRepId], references: [id])
  lines                 QuotationLine[]
  approvalRequests      ApprovalRequest[]
  auditLogs             QuotationAuditLog[]
  comments              QuotationComment[]
  fulfillmentAllocations FulfillmentAllocation[]
  backorders            Backorder[]
  invoices              Invoice[]
  subscriptionSchedules SubscriptionSchedule[]
  dealHealthAlerts      DealHealthAlert[]

  @@map("quotations")
}

model QuotationLine {
  id                 String   @id @default(uuid()) @db.Uuid
  quotationId        String   @db.Uuid
  productId          String   @db.Uuid
  variantId          String?  @db.Uuid
  subscriptionPlanId String?  @db.Uuid
  lineType           LineType @default(ONE_TIME)
  quantity           Int      @default(1)
  unitPrice          Decimal  @db.Decimal(12, 2)
  costPrice          Decimal? @db.Decimal(12, 2)
  discountPercent    Decimal  @default(0.00) @db.Decimal(5, 2)
  discountAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  taxRate            Decimal  @default(0.00) @db.Decimal(5, 2)
  taxAmount          Decimal  @default(0.00) @db.Decimal(12, 2)
  finalUnitPrice     Decimal  @db.Decimal(12, 2)
  subtotal           Decimal  @db.Decimal(14, 2)

  // Relationships
  quotation        Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  variant          ProductVariant?   @relation(fields: [variantId], references: [id])
  subscriptionPlan SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  comments         QuotationComment[]
  allocations      FulfillmentAllocation[]
  backorders       Backorder[]

  @@map("quotation_lines")
}

// -----------------------------------------------------------------------------
// APPROVAL WORKFLOW ENGINE
// -----------------------------------------------------------------------------

model ApprovalRequest {
  id                String               @id @default(uuid()) @db.Uuid
  quotationId       String               @db.Uuid
  requiredRole      ApprovalRoleRequired
  requestedDiscount Decimal?             @db.Decimal(5, 2)
  status            ApprovalStatus       @default(PENDING)
  reviewerId        String?              @db.Uuid
  comments          String?
  createdAt         DateTime             @default(now())
  evaluatedAt       DateTime             @updatedAt

  // Relationships
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  reviewer  User?     @relation("ReviewerApprovals", fields: [reviewerId], references: [id])

  @@map("approval_requests")
}

model QuotationAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  quotationId   String   @db.Uuid
  userId        String?  @db.Uuid
  action        String   // e.g., "CREATED", "DISCOUNT_APPLIED", "MANAGER_APPROVED", "CUSTOMER_COUNTERED"
  reason        String?
  previousState String?  @db.Text
  newState      String?  @db.Text
  timestamp     DateTime @default(now())

  // Relationships
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@map("quotation_audit_logs")
}

enum PairingType {
  UPSELL
  CROSS_SELL
}

// -----------------------------------------------------------------------------
// UPSELL & CROSS-SELL PAIRINGS
// -----------------------------------------------------------------------------

model ProductPairing {
  id                 String      @id @default(uuid()) @db.Uuid
  primaryProductId   String      @db.Uuid
  suggestedProductId String      @db.Uuid
  type               PairingType @default(CROSS_SELL)
  priority           Int         @default(1)
  coPurchaseScore    Decimal     @default(1.00) @db.Decimal(5, 2)
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt

  // Relationships
  primaryProduct   Product @relation("PrimaryProduct", fields: [primaryProductId], references: [id], onDelete: Cascade)
  suggestedProduct Product @relation("SuggestedProduct", fields: [suggestedProductId], references: [id], onDelete: Cascade)

  @@unique([primaryProductId, suggestedProductId])
  @@map("product_pairings")
}

// -----------------------------------------------------------------------------
// MULTI-WAREHOUSE FULFILLMENT & BACKORDERS
// -----------------------------------------------------------------------------

model Warehouse {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @unique
  code                 String?  @unique
  location             String
  shippingCostWeighting Decimal @default(1.00) @db.Decimal(5, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  // Relationships
  inventoryItems InventoryItem[]
  allocations    FulfillmentAllocation[]

  @@map("warehouses")
}

model InventoryItem {
  id               String   @id @default(uuid()) @db.Uuid
  warehouseId      String   @db.Uuid
  productId        String   @db.Uuid
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  reorderLevel     Int      @default(10)
  updatedAt        DateTime @updatedAt

  // Relationships
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  adjustments InventoryAdjustment[]

  @@unique([warehouseId, productId])
  @@map("inventory_items")
}

model InventoryAdjustment {
  id               String                  @id @default(uuid()) @db.Uuid
  inventoryItemId  String                  @db.Uuid
  productId        String                  @db.Uuid
  warehouseId      String                  @db.Uuid
  userId           String?                 @db.Uuid
  type             InventoryAdjustmentType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  createdAt        DateTime                @default(now())

  // Relationships
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("inventory_adjustments")
}

model FulfillmentAllocation {
  id                String            @id @default(uuid()) @db.Uuid
  quotationId       String            @db.Uuid
  quotationLineId   String?           @db.Uuid
  warehouseId       String            @db.Uuid
  productId         String            @db.Uuid
  allocatedQuantity Int
  fulfilledQuantity Int               @default(0)
  isBackorder       Boolean           @default(false)
  status            FulfillmentStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  // Relationships
  quotation Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  line      QuotationLine? @relation(fields: [quotationLineId], references: [id], onDelete: SetNull)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  product   Product        @relation(fields: [productId], references: [id])

  @@map("fulfillment_allocations")
}

model Backorder {
  id                String          @id @default(uuid()) @db.Uuid
  quotationId       String          @db.Uuid
  quotationLineId   String?         @db.Uuid
  productId         String          @db.Uuid
  originalQuantity  Int             @default(0)
  quantityPending   Int
  fulfilledQuantity Int             @default(0)
  status            BackorderStatus @default(WAITING_FOR_STOCK)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relationships
  quotation Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  line      QuotationLine? @relation(fields: [quotationLineId], references: [id], onDelete: SetNull)
  product   Product        @relation(fields: [productId], references: [id])

  @@map("backorders")
}

// -----------------------------------------------------------------------------
// SUBSCRIPTIONS & HYBRID BILLING ENGINE
// -----------------------------------------------------------------------------

model SubscriptionPlan {
  id              String               @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  price           Decimal              @default(0.00) @db.Decimal(12, 2)
  currency        String               @default("INR")
  interval        SubscriptionInterval @default(MONTHLY)
  prorationPolicy String               @default("EXACT_DAY_PRO_RATA")
  refundPolicy    String               @default("PARTIAL_CREDIT_NOTE")
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt

  // Relationships
  quotationLines        QuotationLine[]
  subscriptionSchedules SubscriptionSchedule[]

  @@map("subscription_plans")
}

model SubscriptionSchedule {
  id                 String               @id @default(uuid()) @db.Uuid
  quotationId        String               @db.Uuid
  quotationLineId    String?              @db.Uuid
  customerId         String?              @db.Uuid
  productId          String               @db.Uuid
  planId             String               @db.Uuid
  billingCycle       SubscriptionInterval @default(MONTHLY)
  startDate          DateTime             @default(now())
  nextBillingDate    DateTime
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  unitPrice          Decimal              @default(0.00) @db.Decimal(12, 2)
  quantity           Int                  @default(1)
  currency           String               @default("INR")
  status             String               @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED, EXPIRED
  endDate            DateTime?
  cancellationDate   DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt

  // Relationships
  quotation Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id])
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  invoices  Invoice[]

  @@map("subscription_schedules")
}

model Invoice {
  id                     String                @id @default(uuid()) @db.Uuid
  quotationId            String                @db.Uuid
  customerId             String                @db.Uuid
  subscriptionScheduleId String?               @db.Uuid
  invoiceNumber          String                @unique
  invoiceType            InvoiceType           @default(ONE_TIME)
  subtotal               Decimal               @default(0.00) @db.Decimal(14, 2)
  discountTotal          Decimal               @default(0.00) @db.Decimal(14, 2)
  taxTotal               Decimal               @default(0.00) @db.Decimal(14, 2)
  amount                 Decimal               @db.Decimal(14, 2)
  paidAmount             Decimal               @default(0.00) @db.Decimal(14, 2)
  remainingBalance       Decimal               @default(0.00) @db.Decimal(14, 2)
  currency               String                @default("INR")
  status                 InvoiceStatus         @default(UNPAID)
  issueDate              DateTime              @default(now())
  dueDate                DateTime
  billingPeriodStart     DateTime?
  billingPeriodEnd       DateTime?
  idempotencyKey         String?               @unique
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @default(now()) @updatedAt

  // Relationships
  quotation            Quotation             @relation(fields: [quotationId], references: [id])
  customer             Customer              @relation(fields: [customerId], references: [id])
  subscriptionSchedule SubscriptionSchedule? @relation(fields: [subscriptionScheduleId], references: [id], onDelete: SetNull)
  lines                InvoiceLine[]
  payments             Payment[]

  @@map("invoices")
}

model InvoiceLine {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @db.Uuid
  productId      String?  @db.Uuid
  description    String
  quantity       Int      @default(1)
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal  @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal  @db.Decimal(14, 2)
  lineType       LineType @default(ONE_TIME)
  createdAt      DateTime @default(now())

  // Relationships
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("invoice_lines")
}

model Payment {
  id               String   @id @default(uuid()) @db.Uuid
  invoiceId        String   @db.Uuid
  amount           Decimal  @db.Decimal(14, 2)
  currency         String   @default("INR")
  paymentMethod    String   @default("BANK_TRANSFER") // BANK_TRANSFER, CARD, UPI, CASH, RAZORPAY, OTHER
  gateway          String   @default("MANUAL") // MANUAL, RAZORPAY
  gatewayOrderId   String?
  gatewayPaymentId String?  @unique
  gatewaySignature String?
  status           String   @default("SUCCESS") // SUCCESS, PENDING, FAILED, CANCELLED
  reference        String?
  notes            String?
  createdBy        String?
  transactionDate  DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  // Relationships
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([gatewayOrderId])
  @@map("payments")
}

// -----------------------------------------------------------------------------
// CUSTOMER PORTAL & NEGOTIATION
// -----------------------------------------------------------------------------

model QuotationComment {
  id                   String        @id @default(uuid()) @db.Uuid
  quotationId          String        @db.Uuid
  quotationLineId      String?       @db.Uuid
  authorId             String?       @db.Uuid
  authorType           UserRole      @default(CUSTOMER)
  commentText          String        @db.Text
  isNegotiationCounter Boolean       @default(false)
  proposedDiscount     Decimal?      @db.Decimal(5, 2)
  timestamp            DateTime      @default(now())

  // Relationships
  quotation Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  line      QuotationLine? @relation(fields: [quotationLineId], references: [id], onDelete: SetNull)
  author    User?          @relation(fields: [authorId], references: [id])

  @@map("quotation_comments")
}

// -----------------------------------------------------------------------------
// DEAL HEALTH & ANOMALY ALERTS
// -----------------------------------------------------------------------------

model DealHealthAlert {
  id          String              @id @default(uuid()) @db.Uuid
  quotationId String              @db.Uuid
  alertType   DealHealthAlertType
  severity    DealHealthSeverity  @default(MEDIUM)
  message     String
  isResolved  Boolean             @default(false)
  createdAt   DateTime            @default(now())

  // Relationships
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("deal_health_alerts")
}
